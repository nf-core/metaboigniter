// Offline tests of MS2QUERY_DOWNLOADMODEL use a deterministic wget replacement.
process {
    // The pipeline's process shell. -C (noclobber) makes any second write to versions.yml fail.
    shell = ['bash', '-C', '-e', '-u', '-o', 'pipefail']

    withName: 'MS2QUERY_DOWNLOADMODEL' {
        scratch = false
        beforeScript = '''
            export MS2QUERY_DOWNLOAD_MAX_ATTEMPTS=3
            export MS2QUERY_DOWNLOAD_RETRY_DELAY_SECONDS=0
            mkdir -p mock-bin
            {
                echo '#!/usr/bin/env bash'
                echo 'set -euo pipefail'
                echo 'if [[ "${1:-}" == "-V" ]]; then'
                echo '    echo "GNU Wget 1.18 built for offline testing"'
                echo '    exit 0'
                echo 'fi'
                echo 'output_file="$4"'
                echo 'url="$5"'
                echo 'case "${url##*/}" in'
                echo '    valid.bin)'
                echo '        echo "verified model data" > "$output_file"'
                echo '        ;;'
                echo '    retry.bin)'
                echo '        attempt=0'
                echo '        [[ -f .mock_wget_retry_attempt ]] && read -r attempt < .mock_wget_retry_attempt'
                echo '        ((attempt += 1))'
                echo '        echo "$attempt" > .mock_wget_retry_attempt'
                echo '        if [[ "$attempt" -eq 1 ]]; then'
                echo '            echo "corrupt model data" > "$output_file"'
                echo '        else'
                echo '            echo "verified model data" > "$output_file"'
                echo '        fi'
                echo '        ;;'
                echo '    transport-retry.bin)'
                echo '        attempt=0'
                echo '        [[ -f .mock_wget_transport_attempt ]] && read -r attempt < .mock_wget_transport_attempt'
                echo '        ((attempt += 1))'
                echo '        echo "$attempt" > .mock_wget_transport_attempt'
                echo '        if [[ "$attempt" -eq 1 ]]; then'
                echo '            exit 8'
                echo '        fi'
                echo '        echo "verified model data" > "$output_file"'
                echo '        ;;'
                echo '    always-corrupt.bin)'
                echo '        echo "corrupt model data" > "$output_file"'
                echo '        ;;'
                echo '    *)'
                echo '        echo "Unexpected test URL: $url" >&2'
                echo '        exit 2'
                echo '        ;;'
                echo 'esac'
            } > mock-bin/wget
            chmod +x mock-bin/wget
            export PATH="$PWD/mock-bin:$PATH"
        '''
    }
}

// Offline test of MS2QUERY_DOWNLOADMODEL: nothing is downloaded.
process {
    // The pipeline's process shell. -C (noclobber) makes any second write to versions.yml fail.
    shell = ['bash', '-C', '-e', '-u', '-o', 'pipefail']

    withName: 'MS2QUERY_DOWNLOADMODEL' {
        // beforeScript runs before the change to a scratch directory, so keep the task in its work dir
        scratch = false
        // The input list has no URLs, so download_models.sh fetches nothing. This placeholder
        // stands in for a downloaded model file so that the downloads/*.* output is satisfied.
        beforeScript = 'mkdir -p downloads && printf "offline test placeholder\\n" > downloads/offline_placeholder.txt'
    }
}
